{
  "rules": [
    {
      "allowed": {
        "origins": [
          "*"
        ],
        "methods": [
          "GET",
          "HEAD"
        ],
        "headers": [
          "range",
          "if-match"
        ]
      },
      "exposeHeaders": [
        "content-length",
        "content-range",
        "etag"
      ],
      "maxAgeSeconds": 86400
    }
  ]
}
